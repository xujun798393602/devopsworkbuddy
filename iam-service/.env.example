APP_ENV=development
SERVICE_NAME=iam-service
DATABASE_URL=sqlite+pysqlite:///:memory:
LOCAL_DEV_AUTH_ENABLED=true
JWT_ISSUER=https://iam.local
JWT_AUDIENCE=platform-api
JWT_SIGNING_KEY=replace-with-external-secret
REFRESH_TOKEN_PEPPER=replace-with-external-secret
COOKIE_SECURE=false
BREAK_GLASS_ALLOWED_CIDRS=127.0.0.1/32
BREAK_GLASS_KEK=replace-with-external-secret
