COMPOSE_PROJECT_NAME=wkdevops-project-service
PROJECT_SERVICE_PORT=18080
APP_ENV=container
POSTGRES_PASSWORD=replace-with-a-long-random-secret
DATABASE_POOL_SIZE=5
DATABASE_POOL_TIMEOUT=10
READINESS_TIMEOUT=2
# Production/default build baseline. Do not change to py312-debug for releases.
PYTHON_IMAGE=python:3.13-slim
PYTHON_IMPLEMENTATION=cp313
PYTHON_VERSION_EXPECTED=3.13
APP_IMAGE=wkdevops/project-service:dev-py313
WHEELHOUSE_DIR=wheelhouse/linux-x86_64-cp313
WHEELHOUSE_ID=cp313-production
LOCK_FILE=constraints/cp313-linux-x86_64.txt
API_CONTAINER_NAME=wkDEVOPS-project-service-api-dev
MIGRATE_CONTAINER_NAME=wkDEVOPS-project-service-migrate-dev
DB_CONTAINER_NAME=wkDEVOPS-project-service-postgres-dev
DB_VOLUME_NAME=wkDEVOPS-project-service-data-dev
# Python 3.12.12 debug uses compose.cached-runtime-debug.yaml and an independent
# wkdevops/project-service:dev-py312-debug tag. Installation is always offline.
